# ---------------------------------------------------------------------------
# 本仓库是「零构建、零依赖」的纯静态站：仓库里的文件就是发布内容。
# 因此下面绝大多数条目都是护栏性质 —— 一旦有人误在仓库里装了依赖或跑了构建，
# 这些规则可以保证脏文件不会被提交、更不会被发布到 GitHub Pages。
# ---------------------------------------------------------------------------

# 依赖与包管理（v1 明确禁止出现，见 docs/requirements.md §3）
node_modules/
package.json
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb
.pnpm-store/

# 构建产物（v1 不存在构建步骤，出现即说明流程跑偏）
dist/
build/
out/
.next/
.cache/
.parcel-cache/
.vite/

# 编辑器 / IDE
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# 操作系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# 临时文件与备份
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.log
npm-debug.log*
tmp/
temp/

# Python（本地预览常用 `python -m http.server`，避免虚拟环境被误提交）
__pycache__/
*.py[cod]
.venv/
venv/

# 本地个人笔记 / 草稿（不发布，也不进入版本库）
scratch/
notes.local.md

# 团队协作运行时状态（AgentTeams 内部文件，不属于站点内容）
.agent-teams/
